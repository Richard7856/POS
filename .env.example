# Copiar a .env.local y rellenar con los valores del proyecto Supabase.
# Ambas son NEXT_PUBLIC_: viajan al navegador. La seguridad real la da RLS,
# no el secreto de estas llaves.
#
# Dónde salen: Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
